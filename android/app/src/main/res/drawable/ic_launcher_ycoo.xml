<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="315"
                android:startColor="#FF4CC8FF"
                android:centerColor="#FF2589F2"
                android:endColor="#FF1652D8" />
        </shape>
    </item>
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp"
        android:drawable="@drawable/ic_launcher_bubble" />
</layer-list>
